# CadPilot CRM integration
CADPILOT_URL=http://ec2-18-212-99-22.compute-1.amazonaws.com
CADPILOT_CRM_API_KEY=your-crm-api-key
CADPILOT_WEBHOOK_SECRET=your-webhook-secret
CRM_PUBLIC_URL=https://crm.yourcompany.com
CADPILOT_USE_WEBHOOK=false

# Multipart field names expected by CadPilot
VITE_CADPILOT_FILE_A_FIELD=mass_balance
VITE_CADPILOT_FILE_B_FIELD=design_data
VITE_CADPILOT_CREATE_PATH=/api/integrations/crm/projects
VITE_CADPILOT_STATUS_PATH=/api/integrations/crm/projects/{id}
VITE_CADPILOT_DXF_PATH=/api/integrations/crm/projects/{id}/dxf
